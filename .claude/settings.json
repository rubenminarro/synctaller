{
  "permissions": {
    "deny": [
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan migrate:refresh*)",
      "Bash(php artisan migrate:reset*)",
      "Bash(php artisan db:wipe*)",
      "Bash(php artisan config:cache*)",
      "Bash(npm install*)",
      "Bash(npm i)",
      "Bash(npm i *)",
      "PowerShell(php artisan migrate:fresh*)",
      "PowerShell(php artisan migrate:refresh*)",
      "PowerShell(php artisan migrate:reset*)",
      "PowerShell(php artisan db:wipe*)",
      "PowerShell(php artisan config:cache*)",
      "PowerShell(npm install*)",
      "PowerShell(npm i)",
      "PowerShell(npm i *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-main.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
